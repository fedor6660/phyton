import csv

# ===== КОЛОНКИ (подправьте под свою таблицу) =====
COL_CITY = "Город"
COL_NAME = "ЖК"
COL_PRICE = "Цена за м²"
FILE = "zhk.csv"
# =================================================

def load(path):
    with open(path, encoding="utf-8-sig", newline="") as f:
        sample = f.read(2048)
        f.seek(0)
        delim = ";" if sample.count(";") > sample.count(",") else ","
        rows = []
        for r in csv.DictReader(f, delimiter=delim):
            try:
                price = float(r[COL_PRICE].replace(" ", "").replace(",", "."))
            except (ValueError, KeyError):
                continue
            rows.append({"city": r[COL_CITY].strip(),
                         "name": r[COL_NAME].strip(),
                         "price": price})
        return rows

def pick(rows, city, budget, area, n=3):
    found = []
    for r in rows:
        if r["city"].lower() != city.lower():
            continue
        total = r["price"] * area
        if total <= budget:
            found.append({**r, "total": total})
    # сначала самые близкие к бюджету (максимум за свои деньги)
    found.sort(key=lambda x: budget - x["total"])
    return found[:n]

def main():
    rows = load(FILE)
    city = input("Город: ").strip()
    budget = float(input("Бюджет, ₽: ").replace(" ", ""))
    area = float(input("Желаемая площадь, м²: ").replace(",", "."))

    result = pick(rows, city, budget, area)
    if not result:
        print("Подходящих ЖК не найдено. Увеличьте бюджет или уменьшите площадь.")
        return
    print(f"\nТоп-{len(result)} вариантов в городе {city}:")
    for i, r in enumerate(result, 1):
        print(f"{i}. {r['name']} — {r['price']:,.0f} ₽/м², "
              f"квартира {area:g} м² ≈ {r['total']:,.0f} ₽".replace(",", " "))

if __name__ == "__main__":
    main()
